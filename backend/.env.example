# backend/.env.example
# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values.
# Do NOT commit backend/.env — it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# REQUIRED — generate a strong unique key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The application will refuse to start if this variable is missing.
SECRET_KEY=replace-this-with-a-real-secret-key

# Set to False in production. True enables verbose error pages (dev only).
DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Development:  localhost,127.0.0.1,backend
# Production:   api.yoursite.com
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Public URL of the backend — used to build absolute media/avatar URLs
# returned by the API.  Must NOT have a trailing slash.
# Development:  http://127.0.0.1:8000
# Production:   https://api.yoursite.com
WEBSITE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# CORS / CSRF
# Comma-separated list of trusted frontend origins (include scheme + port).
# Development:  http://localhost:5173,http://127.0.0.1:5173
# Production:   https://yoursite.com
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (MySQL)
# To connect to an external MySQL server in production, set DB_HOST to the
# server's hostname or IP address and supply the correct credentials.
# The DB_HOST=db default assumes the Docker Compose service name.
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=myapp
DB_USER=mysqluser
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=3306

# Set to True to use SQLite for local development without a MySQL server.
USE_SQLITE=False

# ---------------------------------------------------------------------------
# HTTPS redirect (production only, ignored when DEBUG=True)
# Set to False if your reverse proxy (nginx, Caddy) already handles HTTPS
# termination and you do not want Django to redirect HTTP → HTTPS internally.
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------------------
# Sightengine (NSFW image moderation)
# Leave blank to disable moderation (uploads will be passed through without
# checking). Obtain credentials at https://sightengine.com/
# ---------------------------------------------------------------------------
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
