# frontend/.env.example
# ---------------------------------------------------------------------------
# Copy this file to frontend/.env for local development.
# For production, set these variables in your CI/CD pipeline or hosting
# provider's build environment BEFORE running  `npm run build`.
# Do NOT commit frontend/.env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Base URL of the Django backend API.
# Development (default if variable is absent): http://localhost:8000
# Production example:                          https://api.yoursite.com
#
# Must NOT have a trailing slash.
# The frontend derives the WebSocket URL from this value automatically:
#   http://...  →  ws://...
#   https://... →  wss://...
VITE_API_URL=http://localhost:8000
